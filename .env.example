NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=prometheus_lite
POSTGRES_PASSWORD=prometheus_lite
POSTGRES_DB=prometheus_lite
POSTGRES_PORT=5432

PORT=4000
DATABASE_URL=postgresql://prometheus_lite:prometheus_lite@localhost:5432/prometheus_lite
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
BCRYPT_ROUNDS=12
JWT_SECRET=change-me-in-production-this-must-be-at-least-32-chars
JWT_EXPIRES_IN=3600
INGEST_TOKEN=replace-with-a-long-random-collector-token
ALERT_EVALUATION_ENABLED=true
ALERT_EVALUATION_INTERVAL_SECONDS=30
