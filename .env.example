NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=prometheus_lite
POSTGRES_PASSWORD=prometheus_lite
POSTGRES_DB=prometheus_lite
POSTGRES_PORT=5432

PORT=4000
DATABASE_URL=postgresql://prometheus_lite:prometheus_lite@localhost:5432/prometheus_lite
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
BCRYPT_ROUNDS=12
JWT_SECRET=change-me-in-production-this-must-be-at-least-32-chars
JWT_EXPIRES_IN=3600
INGEST_TOKEN=replace-with-a-long-random-collector-token
ALERT_EVALUATION_ENABLED=true
ALERT_EVALUATION_INTERVAL_SECONDS=30
RETENTION_ENABLED=true
RETENTION_INTERVAL_MINUTES=30
RETENTION_SNAPSHOT_DAYS=14
RETENTION_EVENT_DAYS=90
DASHBOARD_CACHE_TTL_MS=3000

API_PORT=4000
WEB_PORT=8080

COLLECTOR_NAME=collector-1
COLLECTOR_API_BASE_URL=http://localhost:4000
COLLECTOR_API_TOKEN=replace-with-a-long-random-collector-token
COLLECTOR_CONFIG_FILE=collector.yaml
COLLECTOR_LOG_LEVEL=info
