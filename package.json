{
  "name": "prometheus-lite",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight monitoring platform: Python collector, TypeScript ingestion and alerting API, React dashboard",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "services/api"
  ],
  "scripts": {
    "api": "npm run dev --workspace services/api",
